{
  "version": 1,
  "title": "Alex Morgan — Portfolio",
  "root": {
    "id": "portfolio-root",
    "type": "section",
    "children": [
      {
        "id": "portfolio-navbar",
        "type": "navbar",
        "props": {
          "brand": "Alex Morgan",
          "links": [
            { "label": "Projects", "href": "#projects" },
            { "label": "About", "href": "#about" }
          ]
        }
      },
      {
        "id": "portfolio-hero",
        "type": "hero",
        "props": {
          "title": "Product designer & creative thinker",
          "description": "I turn complex problems into simple, useful digital experiences."
        }
      },
      {
        "id": "portfolio-projects",
        "type": "section",
        "props": { "title": "Selected projects" },
        "children": [
          {
            "id": "portfolio-project-columns",
            "type": "columns",
            "layout": { "display": "grid", "columns": 2, "gap": 1.5 },
            "children": [
              {
                "id": "portfolio-project-one",
                "type": "card",
                "props": {
                  "title": "Finch Finance",
                  "text": "A calmer way to understand everyday spending."
                }
              },
              {
                "id": "portfolio-project-two",
                "type": "card",
                "props": {
                  "title": "Field Notes",
                  "text": "A digital home for curious people and their ideas."
                }
              }
            ]
          }
        ]
      },
      {
        "id": "portfolio-footer",
        "type": "footer",
        "props": { "text": "Designed with care by Alex Morgan" }
      }
    ]
  }
}
